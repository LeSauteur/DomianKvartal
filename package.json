{
  "name": "domian-kvartal-static-site",
  "private": true,
  "scripts": {
    "build:catalog": "npm run build && node scripts/sync-pages.mjs",
    "check:indexation": "node _tools/check-audit-indexation.mjs --live",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "seo:audit": "node _tools/seo-audit.mjs",
    "qa": "npm run build && npm run check:pages && npm test && npm run check:pages && npm run check:site && node _tools/sync-public-header.mjs --check && npm run seo:audit && npm run test:browser",
    "build": "node scripts/build.mjs",
    "check:pages": "node scripts/sync-pages.mjs --check",
    "dev": "node scripts/preview.mjs",
    "listing": "node scripts/listing.mjs",
    "check:parity": "node scripts/check-parity.mjs",
    "check:site": "node scripts/check-site.mjs",
    "check:artifact": "node scripts/sync-pages.mjs --check-artifact"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0"
  }
}
